# Telegram Bot API Token (@BotFather orqali olingan token)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Bot adminlarining Telegram ID raqamlari (vergul bilan ajratilgan, masalan: 12345678,87654321)
# Telegram ID ni @userinfobot orqali bilish mumkin
ADMIN_IDS=123456789

# Ma'lumotlar bazasi fayli yo'li
DATABASE_PATH=data/bot.db

# Qidiruv sozlamalari
ENABLE_ONLINE_SEARCH=true
SEARCH_MAX_RESULTS=5
SEARCH_CACHE_DAYS=14
